# Copy to .env.local for `npm run dev` / `npm run preview`.
# For Vercel, set these values in Project Settings > Environment Variables and redeploy.
# .env.local is ignored by Git and is not uploaded by Git deployments.
# OPENAI_API_KEY is secret: keep it server-only and never prefix it with VITE_.
OPENAI_API_KEY=
# Optional; defaults to gpt-4o-mini.
OPENAI_MODEL=

# Public backend origin; safe to commit. Used by the server-side API gateway.
# Defaults to the Railway deployment below when omitted.
BACKEND_API_ORIGIN=https://backendlab-production-3052.up.railway.app
# Kakao REST API key and the exact redirect URI registered with Kakao (public configuration).
VITE_KAKAO_REST_API_KEY=
VITE_KAKAO_REDIRECT_URI=http://localhost:3000/oauth/kakao
# Vercel production callback: https://capsule-front-web.vercel.app/oauth/kakao
