    "defaultBorderWidthPx": 0,
    "disabledOpacity": 1,
    "labelWrap": true,
    "loading": {
      "retainWidth": true,
      "retainForeground": true,
      "suppressDuplicateSubmit": true
    },
    "ghostDefaultExceptions": [
      "calendar-navigation",
      "close-button"
    ]
  },
  "focus": {
    "widthPx": 2,
    "offsetPx": 4,
    "color": "focus-ring",
    "mustNotClip": true
  },
  "icons": {
    "source": "https://animateicons.in/icons/lucide",
    "implementation": "shared-Icon-with-local-official-sources",
    "viewBox": 24,
    "strokeWidth": 2,
    "triggers": ["control-pointer-enter", "control-keyboard-focus", "input-group-click"],
    "svgOverflow": "visible",
    "repeat": false,
    "repeatExceptions": ["current-affection-heart"],
    "reducedMotion": "static",
    "appliesToDeferredMvpScreens": true
  },
  "myPage": {
    "viewControl": "shared-Tabs-iconOnly-in-title-row",
    "defaultView": "profile",
    "views": ["profile", "schedule"],
    "iconNames": ["user", "calendar"],
    "controlTargetPx": 44,
    "preserveMountedPanels": true,
    "hideInactivePanel": true,
    "scheduleHash": "#schedule",
    "preserveReturnQuery": true
  },
  "surfaces": {
    "flatSection": "panel",
    "interactiveCard": "surface",
    "dialog": "surface-raised",
    "input": "surface",
    "neutralButton": "control",
    "maxNestedFilledLevels": 2,
    "defaultOutline": false,
    "dialogShadow": "0 16px 48px #00000066",
    "overlay": "overlay",
    "glass": {
      "background": "#191823F2",
      "fallback": "#191823",
      "foreground": "#FAFAFD",
      "scope": [
        "image-overlay-caption"
      ],
      "requiresCompositedContrastCheck": true
    },
    "completionReport": {
      "source": "Full-screen completion scene approved by the user on 2026-11-05",
      "scope": ["report-dialogue", "report-content"],
      "characterAndDialogueShareHorizontalCenter": true,
      "characterBackgroundIsSeparate": true,
      "quoteMotion": "shared-chat-typing-with-reserved-final-height",
      "decoration": "animateicons-lucide-heart-and-sparkles",
      "currentAffectionHeartMotion": { "durationSeconds": 0.8, "repeatDelaySeconds": 0.7, "repeat": "infinite", "trigger": "mount", "restartOnHover": false, "reducedMotion": "static" },
      "numberMotion": { "source": "tween-ui-number-counter", "durationSeconds": 1.8, "playback": "once-on-viewport-entry", "reducedMotion": "final-value", "reserveFinalWidth": true, "clipRollingDigits": "per-digit-with-outer-guard", "digitDirection": "up", "fixedDigitColumns": true, "baseline": "normal-inline-text", "lineHeight": "inherit", "maskPaddingPx": 0 },
      "ctaEmphasis": { "durationSeconds": 3.6, "repeat": "infinite", "reducedMotion": "static", "pauseOnInteraction": true },
      "gradientStart": { "color": "panel", "alpha": 0.88 },
      "gradientEnd": { "color": "canvas", "alpha": 0.82 },
      "blurPx": 24,
      "saturatePercent": 120,
      "fallback": "panel",
      "foreground": "ink",
      "defaultOutline": false,
      "requiresCompositedContrastCheck": true
    },
    "legacyStudyDock": {
      "source": "Pre-design-system study dock; preserved by explicit user request on 2026-11-03",
      "background": "linear-gradient(135deg, #ffffff30, #e7e1ff0d), #2625328c",
      "controlBackground": "#F2EDFFCC",
      "controlForeground": "#242132",
      "finishBackground": "#F04E66E8",
      "finishHover": "#FF6278",
      "finishActive": "#D83B54",
      "blurPx": 24,
      "saturatePercent": 140,
      "tooltipFontSizePx": 11,
      "disabledOpacity": 0.5,
      "smallViewport": {
        "maxExclusivePx": 700,
        "targetPx": 44,
        "secondaryToolsInMore": true
      }
    },
    "popoverShadow": "0 12px 32px #00000066, 0 3px 10px #00000033",
    "floating": {
      "background": "floating",
      "foreground": "ink",
      "secondaryForeground": "muted",
      "menuItemHover": "floating-hover",
      "accountMenuSeparatorGapPx": 8,
      "defaultOutline": false,
      "scope": [
        "tooltip",
        "chart-tooltip",
        "account-menu",
        "study-demo-menu"
      ],
      "exception": "legacyStudyDock preserves its original material"
    }
  },
  "input": {
    "defaultBackground": "surface",
    "foreground": "ink",
    "placeholder": "placeholder",
    "searchPlaceholderTypography": "body-compact",
    "borderExceptions": [
      "schedule-kind-name-date-time",
      "auth-email-password-password-confirm",
      "avatar-nickname"
    ],
    "borderWidthPx": 1,
    "borderColor": "input-border",
    "searchBorder": false,
    "validationPresentation": "Inline FeedbackMessage with aria-invalid and aria-describedby; focus the first invalid field"
  },
  "constraints": {
    "defaultTheme": "dark",
    "lightTheme": "outside v1 scope",
