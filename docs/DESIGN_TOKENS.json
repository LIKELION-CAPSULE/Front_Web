  "buttons": {
    "sizes": {
      "xs": {
        "minHeightPx": 32,
        "minWidthPx": 32,
        "paddingInlinePx": 12,
        "typography": "button-micro",
        "use": "dense non-primary tools only",
        "smallViewportMinTargetPx": 44,
        "smallViewportMaxExclusivePx": 768
      },
      "sm": {
        "minHeightPx": 40,
        "minWidthPx": 40,
        "paddingInlinePx": 16,
        "typography": "button-compact",
        "use": "auxiliary tools",
        "smallViewportMinTargetPx": 44,
        "smallViewportMaxExclusivePx": 768
      },
      "md": {
        "minHeightPx": 44,
        "minWidthPx": 44,
        "paddingInlinePx": 20,
        "typography": "button",
        "use": "general actions"
      },
      "lg": {
        "minHeightPx": 48,
        "minWidthPx": 48,
        "paddingInlinePx": 24,
        "typography": "button",
        "use": "major form/session actions"
      }
    },
