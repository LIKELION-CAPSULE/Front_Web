{
  "name": "capsule-front-web",
  "compatibility_date": "2026-10-23",
  // /api/chat calls OpenAI here; set the key with `npx wrangler secret put OPENAI_API_KEY`.
  "main": "./server/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "previews": {}
}
